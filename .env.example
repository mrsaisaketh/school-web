# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Runtime connection. Use the TRANSACTION pooler (port 6543): serverless
# functions must not hold direct connections. connection_limit=1 keeps each
# invocation to a single connection.
DATABASE_URL="postgresql://<role>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Migrations only. SESSION pooler (port 5432) — pooled transaction mode cannot
# run DDL. Note the direct host db.<project-ref>.supabase.co is IPv6-only and is
# not reachable from Vercel, so use the pooler here too.
DIRECT_URL="postgresql://<role>.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Signs session tokens. Generate with: openssl rand -hex 32
# The API refuses to start without it.
JWT_SECRET="<64-hex-chars>"

# Password given to seeded staff/admin accounts. Only read by prisma/seed.js.
SEED_PASSWORD="<choose-a-strong-one>"

NODE_ENV="development"
