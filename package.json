{
  "name": "school-erp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch backend/server.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "start:backend": "node backend/server.js",
    "build:frontend": "npm run build --prefix frontend",
    "db:push": "prisma db push --schema=backend/prisma/schema.prisma",
    "db:seed": "node backend/prisma/seed.js",
    "vercel-build": "prisma generate --schema=backend/prisma/schema.prisma && npm run build --prefix frontend",
    "test:e2e": "node scripts/e2e.mjs",
    "scan:sast": "semgrep scan --metrics=off --config p/owasp-top-ten --config p/nodejs --config p/react --config p/javascript --config p/secrets --exclude node_modules --exclude dist backend frontend/src api",
    "scan:dast": "docker run --rm -t ghcr.io/zaproxy/zaproxy:stable zap-baseline.py -t ${SCAN_URL:-https://school-erp-two-sage.vercel.app} -I"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^5.22.0"
  }
}
