{
  "name": "school-erp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/clear-ports.js",
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "prestart": "node scripts/clear-ports.js",
    "start": "concurrently \"npm start --prefix backend\" \"npm run dev --prefix frontend\"",
    "start:backend": "npm start --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "seed:backend": "npm run db:seed --prefix backend",
    "db:push": "prisma db push --schema=backend/prisma/schema.prisma",
    "db:seed": "node backend/prisma/seed.js",
    "vercel-build": "prisma generate --schema=backend/prisma/schema.prisma && npm run build --prefix frontend"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prisma": "^5.22.0"
  }
}
